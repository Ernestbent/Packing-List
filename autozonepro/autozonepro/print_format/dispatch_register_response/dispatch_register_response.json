 "font_size": 11,
 "html": "<style>\n@page { size: Letter landscape; margin: 12mm; }\n.print-format { font-family: Arial, sans-serif; font-size: 10pt; color: #111; padding: 0 !important; orientation: landscape; page-size: Letter; }\n@media screen { .print-format { width: 11in !important; max-width: 11in !important; min-height: 8.5in !important; } }\n.report-title { margin: 0 0 24px; font-size: 19pt; font-weight: 400; }\n.report-rule { border: 0; border-top: 1px solid #d7dde3; margin: 0 0 22px; }\n.report-details { margin-bottom: 22px; line-height: 1.55; }\n.report-details strong { font-weight: 700; }\n.report-table { width: 100%; border-collapse: collapse; table-layout: fixed; border: 1px solid #e5e7eb; }\n.report-table thead { display: table-header-group; }\n.report-table tr { page-break-inside: avoid; }\n.report-table th, .report-table td { border: 1px solid #e5e7eb; padding: 11px 8px; vertical-align: top; overflow-wrap: anywhere; word-break: normal; line-height: 1.45; }\n.report-table th { background: #fff; color: #64748b; font-weight: 400; text-align: left; }\n.report-table td { color: #111; }\n.report-table .center { text-align: center; }\n.report-table .number { text-align: right; }\n.report-table tfoot td { font-weight: 400; padding-top: 8px; padding-bottom: 8px; }\n</style>\n<h1 class=\"report-title\">Dispatch Register Details</h1>\n<hr class=\"report-rule\">\n<div class=\"report-details\">\n  <strong>Register Number:</strong> {{ doc.name }}<br>\n  <strong>Date:</strong> {{ frappe.utils.getdate(doc.date_time).strftime('%d-%m-%Y') if doc.date_time else '' }}<br>\n  <strong>Submitted By:</strong> {{ doc.submitted_by or doc.owner or '' }}\n</div>\n<hr class=\"report-rule\">\n<table class=\"report-table\">\n  <colgroup>\n    <col style=\"width: 3%\"><col style=\"width: 10%\"><col style=\"width: 8%\"><col style=\"width: 13%\"><col style=\"width: 15%\"><col style=\"width: 14%\"><col style=\"width: 10%\"><col style=\"width: 12%\"><col style=\"width: 8%\"><col style=\"width: 7%\">\n  </colgroup>\n  <thead>\n    <tr>\n      <th class=\"center\">#</th>\n      <th>Sales<br>Order</th>\n      <th>Date</th>\n      <th>Delivery Note</th>\n      <th>Customer<br>Name</th>\n      <th>Driver Name</th>\n      <th>Vehicle No</th>\n      <th>Tel No</th>\n      <th>Number Of<br>Bundles</th>\n      <th>Total<br>Expenses</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for row in doc.rows %}\n    {% set sales_order = row.sales_order or frappe.db.get_value('Delivery Note Item', {'parent': row.delivery_note, 'parenttype': 'Delivery Note'}, 'against_sales_order') %}\n    <tr>\n      <td class=\"center\">{{ loop.index }}</td>\n      <td>{{ sales_order or '' }}</td>\n      <td>{{ frappe.utils.getdate(doc.date_time).strftime('%Y-%m-%d') if doc.date_time else '' }}</td>\n      <td>{{ row.delivery_note or '' }}</td>\n      <td>{{ row.customer_name or '' }}</td>\n      <td>{{ row.driver_name or '' }}</td>\n      <td>{{ row.vehicle_number or '' }}</td>\n      <td>{{ row.telephone or '' }}</td>\n      <td>{{ row.number_of_bundles or 0 }}</td>\n      <td>{{ '%.0f'|format(row.total_expense or 0) }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n  <tfoot>\n    <tr>\n      <td></td>\n      <td>Total</td>\n      <td colspan=\"6\"></td>\n      <td>{{ doc.total_bundles or 0 }}</td>\n      <td>{{ '%.0f'|format(doc.total_expense or 0) }}</td>\n    </tr>\n  </tfoot>\n</table>",
